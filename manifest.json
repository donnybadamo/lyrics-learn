{
  "manifest_version": 3,
  "name": "Lyrics Learn Spanish",
  "version": "1.0.0",
  "description": "Learn Spanish through music - inline English translations, word definitions, and vocabulary saving. Works with Spotify.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
